# ============================================================================
# .gitignore — ItInfra Repository
# ============================================================================

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*

# Node / Bun (se futuro modulo UI)
node_modules/
dist/
build/
*.log
.env
.env.local
.env.*.local

# File temporanei e backup
*.tmp
*.bak
*.backup
_legacy/
cache/

# Secret (mai committere credenziali)
*.pem
*.key
*.secret
secrets/
credentials.json
**/.vault.enc
**/.vault.lock
vault-keys/
.worktrees/

# File di sistema
.directory
.Trash-*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
